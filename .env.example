# Local Wolfcha demonstration. Do not commit .env.local.
ZERONE_DEMO_MODE=1
NEXT_PUBLIC_ZERONE_DEMO_MODE=1
ZERONE_HUB_MODE=1
NEXT_PUBLIC_ZERONE_HUB_MODE=1
ZERONE_HUB_BASE_URL=http://localhost:8081
ZERONE_SERVICE_KEY=
# Preferred: nine independent Zerone Agent runtimes. JSON is server-only and maps character ID to {name,url,apiKey}.
ZERONE_AGENTS_JSON=
# Aliyun Model Studio voice (server-side key; set public flag only after the key is configured)
NEXT_PUBLIC_ALIYUN_VOICE_ENABLED=0
ALIYUN_VOICE_API_KEY=
ALIYUN_VOICE_BASE_URL=https://dashscope.aliyuncs.com
ALIYUN_ASR_MODEL=qwen-audio-3.1-asr-flash
ALIYUN_TTS_MODEL=qwen-audio-3.1-tts-flash
ALIYUN_TTS_VOICE=longanhuan_v3.1
# Optional direct-provider fallback when ZERONE_HUB_MODE=0
OPENAI_COMPAT_BASE_URL=https://api.example.com/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
